{
  "name": "cocraft",
  "version": "0.4.0",
  "private": true,
  "description": "A video creation, asset storyboard, and editing workbench for people and coding agents",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "test:unit": "tsx scripts/unit-phase1.ts",
    "test:v03": "node scripts/phase1-ui-check.mjs && node scripts/v03-full-check.mjs",
    "test:v04": "node scripts/v05-acceptance.mjs",
    "test:redblue": "node scripts/red-blue-regression.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "package": "npm run build && electron-builder --mac dir --arm64",
    "package:dmg": "npm run build && electron-builder --mac dmg --arm64",
    "package:release": "node scripts/release-mac.mjs",
    "test:ui": "node scripts/functional-check-v2.mjs",
    "smoke:agent": "node scripts/agent-smoke.mjs",
    "smoke:models": "node scripts/generation-smoke.mjs",
    "smoke:mcp": "node scripts/mcp-smoke.mjs",
    "mcp": "node scripts/cocraft-mcp.mjs",
    "check:materials": "node scripts/material-check.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@remotion/media": "4.0.544",
    "@remotion/player": "4.0.544",
    "@remotion/renderer": "4.0.544",
    "@sinclair/typebox": "0.34.41",
    "esbuild": "^0.27.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remotion": "4.0.544",
    "roughjs": "^4.6.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.544",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "45.3.3",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0",
    "prettier": "3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "build": {
    "appId": "studio.cocraft.desktop",
    "productName": "CoCraft",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/render-bundle/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "public/**/*",
          "skills/**/*",
          "icon.icns",
          "packs/**/*"
        ]
      },
      {
        "from": "dist/render-bundle",
        "to": "render-bundle"
      },
      {
        "from": "scripts",
        "to": "mcp",
        "filter": [
          "cocraft-mcp.mjs"
        ]
      },
      {
        "from": "node_modules/@remotion/compositor-darwin-arm64",
        "to": "media-tools",
        "filter": [
          "ffmpeg",
          "ffprobe",
          "remotion",
          "*.dylib",
          "LICENSE.md"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": "dir",
      "identity": "-",
      "icon": "resources/icon.icns",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "CoCraft ${version}",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "resources/icon.icns",
      "iconSize": 108,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 145,
          "y": 190
        },
        {
          "x": 395,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "directories": {
      "output": "release/0.4"
    },
    "asarUnpack": [
      "node_modules/@esbuild/**/*",
      "node_modules/esbuild/**/*",
      "node_modules/@remotion/compositor-*/**/*",
      "node_modules/@silvia-odwyer/**/*"
    ],
    "electronDist": "node_modules/electron/dist"
  },
  "author": "CoCraft"
}
